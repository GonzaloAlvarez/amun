#!/bin/bash
# amun L2 harness: converge amun (and plugins) inside a fresh VM per platform.
# VM lifecycle is delegated to kora (repo: GonzaloAlvarez/kora); this script
# owns the payload (stage repos, run ./amun) and the homelab-specific guest
# tweaks. The Termux platform stays Docker-based below.
#
#   ./test [platform] [-p|--plugins <p> ...] [--cloud] [--profile <p>] [--yes]
#   DEBUG=1 ./test debian     # interactive shell in the VM before teardown
#   KORA_BIN=~/dev/kora/kora ./test debian   # unreleased kora working tree

PLUGINS=()
PLATFORM=""
CLOUD=0
YES=0
CLOUD_PROFILE=""
KORA="${KORA_BIN:-kora}"

# Parse arguments
while [[ $# -gt 0 ]]; do
	case "$1" in
		-p|--plugins)
			shift
			while [[ $# -gt 0 ]] && [[ ! "$1" =~ ^- ]]; do
				PLUGINS+=("$1")
				shift
			done
			;;
		--cloud)
			CLOUD=1
			shift
			;;
		--kvm)
			echo "note: --kvm is deprecated (cloud runs always use the nested-virt 'kvm' devbox)" >&2
			shift
			;;
		--yes)
			YES=1
			shift
			;;
		--profile)
			if [ $# -lt 2 ]; then
				echo "Error: --profile requires a value" >&2
				exit 1
			fi
			CLOUD_PROFILE="$2"
			shift 2
			;;
		*)
			if [ -z "$PLATFORM" ]; then
				PLATFORM="$1"
			fi
			shift
			;;
	esac
done

function log_output {
	if [ -z "$2" ] || [ "$2" = "true" ]; then
		echo "$(date "+%Y/%m/%d %H:%M:%S") $1"
	fi
}

# Only invoked from SIGINT/SIGTERM traps — exit nonzero so an interrupted
# run never reads as a pass.
function cleanup {
	log_output "[HOST] Stopping runner script"
	exit 130
}

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PARENT_DIR="$(dirname "$SCRIPT_DIR")"
TMPWORK="$(mktemp -d)"
trap 'rm -rf "$TMPWORK"' EXIT

function kcmd {
	"$KORA" cmd "$@"
}

# Stage a repo into the VM at ~/.amun/<basename>. Tarball transport via
# `kora copy` for every backend — what runs in the guest is always the staged
# tree, never a live host mount (the old CWD-relative virtiofs share tested
# whatever directory you happened to run from).
function stage_repo {
	local dir="$1" base tarball
	base="$(basename "$dir")"
	tarball="$TMPWORK/${base}.tar.gz"
	# 'tst'/'.venv'/'.git' are dead weight on the AMUN_REPO path and 'tst'
	# could hold GB-scale VM artifacts in old checkouts.
	COPYFILE_DISABLE=1 tar --no-xattrs --exclude='.venv' --exclude='tst' \
		--exclude='.git' -czf "$tarball" -C "$(dirname "$dir")" "$base" || return 1
	"$KORA" copy "$tarball" "vm:/tmp/${base}.tar.gz" || return 1
	kcmd "mkdir -p ~/.amun && cd ~/.amun && rm -rf '${base}' && tar -xzf '/tmp/${base}.tar.gz' && rm -f '/tmp/${base}.tar.gz'" || return 1
}

# Converge amun core + requested plugins inside a fresh kora VM.
#   $1 = platform (kora OS name)   $2 = local|cloud
function test_platform {
	local os="$1" side="${2:-local}" rc=0

	# Per-run isolated state home: unique VM names, no interference with a
	# dev VM in the operator's default home, guaranteed post-run cleanup.
	# (Image caches are shared by design — no re-downloads.)
	export KORA_HOME="$TMPWORK/korahome-$os"
	log_output "[HOST] VM display from a 2nd terminal: KORA_HOME=$KORA_HOME kora vnc"

	local newargs=(new "$os")
	if [ "$side" = "cloud" ]; then
		newargs+=(--cloud --yes)
		[ -n "$CLOUD_PROFILE" ] && newargs+=(--profile "$CLOUD_PROFILE")
	fi
	"$KORA" "${newargs[@]}" || return 1
	trap '"$KORA" rm >/dev/null 2>&1; cleanup' SIGINT SIGTERM

	# --- homelab-specific guest tweaks (deliberately NOT in kora) ---------
	if [ "$os" = "sequoia" ]; then
		# Prefer the homelab LAN gateway as primary DNS so .lan names
		# resolve in the guest. TCP/53 probe: Virtualization.framework
		# drops guest ICMP.
		log_output "[HOST] Probing whether 10.0.0.1:53 is reachable from guest"
		if kcmd "/usr/bin/nc -z -G 2 -w 2 10.0.0.1 53 > /dev/null 2>&1"; then
			kcmd 'sudo networksetup -setdnsservers "Ethernet" 10.0.0.1 8.8.8.8'
		else
			kcmd 'sudo networksetup -setdnsservers "Ethernet" 8.8.8.8'
		fi
	fi
	if [ "$os" = "debian" ] && [ "$side" = "local" ]; then
		# cirruslabs bookworm image races apt with unattended-upgrades
		kcmd "sudo systemctl stop unattended-upgrades" || true
	fi

	# --- payload: amun core, then plugins ---------------------------------
	log_output "[HOST] Staging amun repository"
	stage_repo "$SCRIPT_DIR" || rc=1
	kcmd 'cp ~/.amun/amun/amun ~/amun && chmod +x ~/amun' || rc=1
	log_output "[HOST] Running amun core"
	kcmd 'AMUN_REPO=$HOME/.amun/amun ./amun' || rc=$?

	for plugin in "${PLUGINS[@]}"; do
		log_output "[HOST] Running plugin: ${plugin}"
		stage_repo "$PARENT_DIR/amun-${plugin}" || { rc=1; continue; }
		kcmd "AMUN_REPO=\$HOME/.amun/amun-${plugin} ./amun ${plugin}" || rc=$?
	done

	if [ "${DEBUG:-0}" = 1 ]; then
		log_output "[HOST] DEBUG=1 - interactive shell in the VM (exit to tear down)"
		"$KORA" ssh
	fi

	log_output "[HOST] Removing VM"
	"$KORA" rm || true
	trap - SIGINT SIGTERM
	return "$rc"
}

# --- Termux (Docker; termux/termux-docker userspace, no Android runtime) ---
# The container mirrors a real device except for what the Termux app itself
# provides, so tx() injects: TERMUX_VERSION (the repo-wide Termux signal) and
# termux-exec's LD_PRELOAD (rewrites /bin/sh & /usr/bin/env shebangs — active
# by default in the real app, not wired up in the image).
TERMUX_DOCKER_IMAGE="${TERMUX_DOCKER_IMAGE:-termux/termux-docker:aarch64}"
TERMUX_PREFIX="/data/data/com.termux/files/usr"
TERMUX_CONTAINER="amun-termux-test-$$"

function tx() {
    docker exec --user system \
        -e TERMUX_VERSION=docker \
        -e "LD_PRELOAD=$TERMUX_PREFIX/lib/libtermux-exec-ld-preload.so" \
        "$TERMUX_CONTAINER" "$TERMUX_PREFIX/bin/bash" -l -c "$*"
}

function termux_teardown {
    docker rm -f "$TERMUX_CONTAINER" >/dev/null 2>&1 || true
}

function test_termux {
    local mode="${1:-full}"
    local rc=0

    if ! docker info >/dev/null 2>&1; then
        log_output "[HOST] Docker is required for termux tests"
        return 1
    fi

    # ARM containers can trip Docker's default seccomp policy on
    # personality(); unconfined by default, TERMUX_DOCKER_UNCONFINED=0 opts
    # back into the default profile.
    local SECOPT=()
    if [ "${TERMUX_DOCKER_UNCONFINED:-1}" = "1" ]; then
        SECOPT=(--security-opt seccomp=unconfined)
    fi

    log_output "[HOST] Testing Termux ($mode) with $TERMUX_DOCKER_IMAGE"
    termux_teardown
    docker run -d --name "$TERMUX_CONTAINER" "${SECOPT[@]}" \
        -v "$(cd "$(dirname "$0")/.." && pwd):/workspace/dev:ro" \
        "$TERMUX_DOCKER_IMAGE" sleep infinity >/dev/null
    trap 'log_output "[HOST] Killing the termux container"; termux_teardown; cleanup' SIGINT SIGTERM

    local ARGS=""
    if [ "$mode" = "bootstrap" ]; then
        ARGS="-e amun_skip_dotfiles=true -e amun_termux_start_sshd=false"
    fi

    # First run: the bootstrap itself, from the working tree.
    tx 'cp /workspace/dev/amun/amun-termux "$HOME/amun-termux" && chmod +x "$HOME/amun-termux"' || rc=$?
    tx "AMUN_REPO=/workspace/dev/amun AMUN_ANSIBLE_ARGS='$ARGS' \"\$HOME/amun-termux\"" || rc=$?

    log_output "[HOST] Verifying Termux provisioning results"
    tx 'test ! -e "$HOME/.provisioning"' || { rc=1; log_output "[FAIL] ~/.provisioning not cleaned"; }
    tx "head -1 \"\$HOME/bin/amun\" | grep -q '^#!$TERMUX_PREFIX/bin/bash'" || { rc=1; log_output "[FAIL] wrapper shebang"; }
    tx 'cmp -s "$HOME/.local/lib/amun/amun-termux" /workspace/dev/amun/amun-termux' || { rc=1; log_output "[FAIL] installed amun-termux differs"; }
    tx 'dpkg -s openssh tmux neovim jq rsync ncurses-utils >/dev/null && command -v tput >/dev/null' || { rc=1; log_output "[FAIL] termux_packages missing"; }

    if [ "$mode" = "bootstrap" ]; then
        tx '! pgrep -f "(^|/)sshd$" >/dev/null' || { rc=1; log_output "[FAIL] sshd running despite skip"; }
        tx 'test ! -d "$HOME/.dotfiles"' || { rc=1; log_output "[FAIL] dotfiles present despite skip"; }
    else
        tx "grep -q '^Port 8022' $TERMUX_PREFIX/etc/ssh/sshd_config" || { rc=1; log_output "[FAIL] sshd port"; }
        tx "grep -q '^PasswordAuthentication no' $TERMUX_PREFIX/etc/ssh/sshd_config" || { rc=1; log_output "[FAIL] sshd password auth"; }
        tx "$TERMUX_PREFIX/bin/sshd -t" || { rc=1; log_output "[FAIL] sshd -t"; }
        tx 'pgrep -f "(^|/)sshd$" >/dev/null' || { rc=1; log_output "[FAIL] sshd not running"; }
        tx 'test -s "$HOME/.ssh/authorized_keys" && grep -q "^ssh-" "$HOME/.ssh/authorized_keys"' || { rc=1; log_output "[FAIL] authorized_keys"; }
        tx '[ "$(stat -c %a "$HOME/.ssh")" = "700" ]' || { rc=1; log_output "[FAIL] ~/.ssh mode"; }
        tx 'test -d "$HOME/.dotfiles/.git" && test -d "$HOME/.gear/.git"' || { rc=1; log_output "[FAIL] dotfiles/gear clones"; }
        tx 'test -f "$HOME/.bashrc" && test -L "$HOME/bin/seshat" && test -d "$HOME/.vim/.git" && test -d "$HOME/.config/nvim/.git"' || { rc=1; log_output "[FAIL] seshat targets"; }
        tx 'test ! -d "$HOME/.dotfiles/.seshat/venv"' || { rc=1; log_output "[FAIL] seshat venv not cleaned"; }
        tx 'head -1 "$HOME/.claude/statusline.sh" | grep -q "env bash" && echo "{}" | "$HOME/.claude/statusline.sh" >/dev/null' || { rc=1; log_output "[FAIL] statusline"; }
        tx 'export PATH="$HOME/bin:$PATH"; "$HOME/.gear/run" kauket version >/dev/null' || { rc=1; log_output "[FAIL] gear kauket"; }
        tx 'export PATH="$HOME/bin:$PATH"; "$HOME/.gear/run" clouddevbox --help >/dev/null' || { rc=1; log_output "[FAIL] gear clouddevbox"; }

        # Second run through the installed wrapper: proves wrapper->lib exec,
        # the atomic self-overwrite of the running script, and idempotence.
        log_output "[HOST] Termux second run (idempotence via ~/bin/amun)"
        tx 'AMUN_REPO=/workspace/dev/amun "$HOME/bin/amun" 2>&1 | tee "$HOME/run2.log"' || rc=$?
        tx 'grep -E "changed=0 .*failed=0" "$HOME/run2.log" >/dev/null' || { rc=1; log_output "[FAIL] second run not idempotent"; }
        tx 'test ! -e "$HOME/.provisioning"' || { rc=1; log_output "[FAIL] ~/.provisioning not cleaned (run 2)"; }

        for plugin in "${PLUGINS[@]}"; do
            log_output "[HOST] Running termux plugin: ${plugin}"
            tx "AMUN_REPO=/workspace/dev/amun-${plugin} \"\$HOME/bin/amun\" ${plugin}" || rc=$?
        done
    fi

    if [ ${DEBUG:-0} -eq 1 ]; then
        docker exec -it --user system \
            -e TERMUX_VERSION=docker \
            -e "LD_PRELOAD=$TERMUX_PREFIX/lib/libtermux-exec-ld-preload.so" \
            "$TERMUX_CONTAINER" "$TERMUX_PREFIX/bin/bash" -l
    fi

    termux_teardown
    return "$rc"
}

# Accumulate per-platform failures so the script's exit code reflects the
# worst result instead of whatever the last cleanup command returned.
FAILED=0
function run_platform {
    log_output "[HOST] === Running $* ==="
    "$@" || { FAILED=1; log_output "[HOST] === $* FAILED ==="; }
}

if [ "$PLATFORM" != "termux" ] && [ "$PLATFORM" != "android" ] && \
   [ "$PLATFORM" != "termux-bootstrap" ] && ! command -v "$KORA" >/dev/null 2>&1; then
	echo "Error: kora not found on PATH; install via gear: ~/.gear/com/kora/setup-darwin" >&2
	echo "       (or point KORA_BIN at a working tree: KORA_BIN=~/dev/kora/kora)" >&2
	exit 1
fi

if [ "$CLOUD" = 1 ]; then
	case "$PLATFORM" in
		""|debian|ubuntu|arch) ;;
		*)
			echo "Error: --cloud supports debian/ubuntu/arch (QEMU/KVM guests on the 'kvm' devbox)" >&2
			exit 1
			;;
	esac
	# Cloud runs converge a FRESH VM on the persistent 'kvm' devbox (created
	# on first use, m7i.large ~$0.10/h while running, autostop 12h). Unlike
	# the old throwaway-box path, amun core IS re-run (it's a fresh guest)
	# and the box persists between runs - no per-run CDK deploy.
	if [ "$YES" != 1 ]; then
		if [ ! -t 0 ]; then
			echo "Error: --cloud is billable; pass --yes to confirm non-interactively" >&2
			exit 1
		fi
		echo "COST: uses the billable 'kvm' devbox (m7i.large ~\$0.10/h, created if missing)."
		printf "Continue? [y/N] "
		read -r ans
		[ "$ans" = "y" ] || exit 1
	fi
	run_platform test_platform "${PLATFORM:-debian}" cloud
	exit "$FAILED"
fi

case "$PLATFORM" in
    mac|sequoia)
        run_platform test_platform sequoia
        ;;
    debian)
        run_platform test_platform debian
        ;;
    ubuntu)
        run_platform test_platform ubuntu
        ;;
    arch|linux/arch)
        run_platform test_platform arch
        ;;
    linux)
        # Deliberately excludes termux: in amun's platform model `linux`
        # means conventional FHS distributions; Termux is its own platform.
        run_platform test_platform debian
        run_platform test_platform ubuntu
        run_platform test_platform arch
        ;;
    termux-bootstrap)
        run_platform test_termux bootstrap
        ;;
    termux|android)
        run_platform test_termux full
        ;;
    "")
        run_platform test_platform sequoia
        run_platform test_platform debian
        run_platform test_platform ubuntu
        run_platform test_platform arch
        ;;
    *)
        echo "Usage: $0 [platform] [-p|--plugins <plugin> ...] [--cloud] [--profile <p>] [--yes]"
        echo ""
        echo "  mac, sequoia     - Test on macOS Sequoia"
        echo "  debian           - Test on Debian"
        echo "  ubuntu           - Test on Ubuntu"
        echo "  arch, linux/arch - Test on Arch Linux"
        echo "  linux            - Test on Debian + Ubuntu + Arch"
        echo "  termux-bootstrap - Test Termux bootstrap in Docker (no dotfiles/sshd)"
        echo "  termux, android  - Test complete Termux provisioning in Docker"
        echo "  (no args)        - Test on all stable platforms"
        echo ""
        echo "  -p, --plugins    - Run amun plugins after base provisioning"
        echo "  --cloud          - Run in a fresh QEMU/KVM VM on the persistent 'kvm'"
        echo "                     devbox (billable; debian/ubuntu/arch; core IS re-run)"
        echo "  --profile <p>    - AWS profile for --cloud (clouddevbox picker when omitted)"
        echo "  --yes            - Skip the --cloud cost confirmation"
        echo ""
        echo "  DEBUG=1          - Interactive shell in the VM before teardown"
        echo "  KORA_BIN=<path>  - Use an uninstalled kora (e.g. ~/dev/kora/kora)"
        echo "  VM display: kora's per-run state home is printed in the logs; attach"
        echo "  with 'kora vnc' from that KORA_HOME, or DEBUG=1 + a second terminal."
        exit 1
        ;;
esac

exit "$FAILED"
